[Unit]
Description=Export one Mooncake shared pool capacity to node_exporter textfile
After=docker.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /opt/mooncake-capacity/mooncake_capacity_textfile.py --container mooncake-master-dsv41-sglang-tp2 --output /var/lib/prometheus/node-exporter/mooncake-capacity.prom
TimeoutStartSec=12s
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/prometheus/node-exporter
RestrictAddressFamilies=AF_UNIX AF_INET
